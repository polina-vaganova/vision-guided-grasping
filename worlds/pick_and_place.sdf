<?xml version="1.0"?>
<!--
  Pick and Place Scene — Gazebo Harmonic (SDF 1.9)

  ┌─ Геометрия сцены ─────────────────────────────────────────────────────┐
  │  Пол:             z = 0                                               │
  │  Столешница:      поверхность z = 0.780 м                             │
  │  Стойка робота:   пластина сверху z = 0.780 м (совпадает со столом)   │
  │  Основание UR5:   z = 0.780 м (стоит на стойке)                       │
  │                                                                       │
  │  Стол (origin = 0,0,0): X ∈ [-0.55, 0.55], Y ∈ [-0.37, 0.37]        │
  │  Стойка: Y = -0.58 (за передним краем стола Y=-0.37)                  │
  │  UR5 base: (0, -0.58, 0.780)                                          │
  │                                                                       │
  │  Досягаемость UR5 (reach ≈ 850 мм от базы):                           │
  │  При базе на z=0.780, коробки на z≈0.800 — разность ≈ 20 мм.         │
  │  Горизонтальное расстояние до центра стола ≈ 0.58 м << 0.85 м ✓      │
  └───────────────────────────────────────────────────────────────────────┘
-->
<sdf version="1.9">
  <world name="pick_and_place">

    <!-- ===== Физика ===== -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ===== Плагины ===== -->
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"           name="gz::sim::systems::Contact"/>

    <!-- ===== Освещение ===== -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <light name="fill" type="directional">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.35 0.35 0.45 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.5 -0.1 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ===== Пол ===== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== Стол =====
      origin = (0, 0, 0)
      Столешница: центр (0,0,0.755), поверхность z=0.780
      Размер: 1.1 x 0.74 x 0.05
      Рабочая зона: X ∈ [-0.50, 0.50], Y ∈ [-0.32, 0.32]
    -->
    <include>
      <uri>model://table</uri>
      <name>table</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ===== Монтажная стойка UR5 =====
      Стойка высотой 0.75м + пластина 0.03м = верхняя грань z=0.780.
      Позиция: X=0, Y=-0.58 (за передним краем стола Y=-0.37)
    -->
    <include>
      <uri>model://robot_mount</uri>
      <name>robot_mount</name>
      <pose>0 -0.58 0 0 0 0</pose>
    </include>

    <!-- ===== UR5 + RG2 gripper =====
      Основание робота на верхней грани стойки: z=0.780
      Y=-0.58: рука смотрит на стол, плечо не пересекает его.
      Конфигурация суставов задана в блоке <state>.
    -->
    <include>
      <uri>model://ur5</uri>
      <name>ur5</name>
      <pose>0 -0.58 0.780 0 0 0</pose>
    </include>

    <!-- ===== Лоток назначения =====
      Стойка + жёлтый лоток справа от стола.
      Позиция: X=0.65, Y=-0.15 (справа от стола, ближе к роботу).
      Лоток изнутри: z=0.720 (чуть ниже стола — коробки не выпадут при опускании).
      Верх стенок лотка: z=0.780 = высота стола (одинаковый уровень).
      Расстояние от базы UR5 до центра лотка: ≈0.78 м < 850 мм ✓
    -->
    <include>
      <uri>model://destination_tray</uri>
      <name>destination_tray</name>
      <!-- X=0.825: левая стенка лотка (outer) окажется на X=0.550 = правый край стола -->
      <!-- Y=0: центр лотка совпадает с центром стола по Y                               -->
      <pose>0.825 0 0 0 0 0</pose>
    </include>

    <!-- ===== Коробки на столе =====
      Поверхность стола: z=0.780
      z_center = 0.780 + 0.003 (зазор) + half_height

      box_small  (0.06×0.04×0.04 м): z = 0.780 + 0.003 + 0.020 = 0.803
      box_medium (0.10×0.07×0.06 м): z = 0.780 + 0.003 + 0.030 = 0.813
      box_large  (0.16×0.12×0.10 м): z = 0.780 + 0.003 + 0.050 = 0.833

      Коробки расставлены в досягаемой зоне стола
      (ближе к роботу, X ∈ [-0.30, 0.30], Y ∈ [-0.10, 0.28])
    -->
    <include>
      <uri>model://box_small</uri>
      <name>box_small_1</name>
      <pose>-0.18 0.05 0.803 0 0 0.30</pose>
    </include>

    <include>
      <uri>model://box_small</uri>
      <name>box_small_2</name>
      <pose> 0.20 0.18 0.803 0 0 -0.50</pose>
    </include>

    <include>
      <uri>model://box_medium</uri>
      <name>box_medium_1</name>
      <pose> 0.05 -0.05 0.813 0 0 0.10</pose>
    </include>

    <include>
      <uri>model://box_medium</uri>
      <name>box_medium_2</name>
      <pose>-0.22 0.20 0.813 0 0 1.00</pose>
    </include>

    <include>
      <uri>model://box_large</uri>
      <name>box_large_1</name>
      <pose> 0.10 0.25 0.833 0 0 0.00</pose>
    </include>

    <!-- ===== RGB-камера overhead =====
      Высота 1.9м над полом, над центром стола.
      RPY = (0, π/2, 0): ось -Z камеры смотрит вниз.
      FOV=60°, 640×480 px → покрывает ~2.2×1.6 м на высоте стола.
    -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0 0 1.90 0 1.5708 0</pose>
      <link name="camera_link">
        <visual name="body">
          <geometry><box><size>0.06 0.06 0.04</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>RGB_INT8</format>
            </image>
            <clip><near>0.1</near><far>10.0</far></clip>
          </camera>
          <topic>/camera/image_raw</topic>
        </sensor>
      </link>
    </model>

    <!-- ===== Начальная конфигурация UR5 =====
      Конфигурация "ready":
        shoulder_pan   =  0        смотрит на стол
        shoulder_lift  = -1.9      рука наклонена вперёд к столу
        elbow          =  1.8      локоть согнут
        wrist_1        = -1.5708   запястье горизонтально
        wrist_2        = -1.5708   гриппер смотрит вниз
        wrist_3        =  0

      Примечание: <state> обрабатывается при загрузке мира gz-sim 8.
    -->
    <state world_name="pick_and_place">
      <model name="ur5">
        <joint name="shoulder_pan_joint">
          <angle axis="0">0</angle>
        </joint>
        <joint name="shoulder_lift_joint">
          <angle axis="0">-1.9</angle>
        </joint>
        <joint name="elbow_joint">
          <angle axis="0">1.8</angle>
        </joint>
        <joint name="wrist_1_joint">
          <angle axis="0">-1.5708</angle>
        </joint>
        <joint name="wrist_2_joint">
          <angle axis="0">-1.5708</angle>
        </joint>
        <joint name="wrist_3_joint">
          <angle axis="0">0</angle>
        </joint>
      </model>
    </state>

  </world>
</sdf>
