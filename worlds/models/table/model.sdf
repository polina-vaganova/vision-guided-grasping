<?xml version="1.0"?>
<sdf version="1.9">
  <model name="table">
    <static>true</static>
    <!--
      Единый линк — надёжно для static-моделей в Gazebo Harmonic.
      Поверхность столешницы: z = 0.780 м (при model pose = 0,0,0,0,0,0)
        Столешница: центр z=0.755, толщина 0.05 → верх z=0.780
        Ножки:      высота 0.730, центр z=0.365

      Размер стола: 1.10 × 0.74 × 0.05 м
      Ножки стоят на X=±0.50, Y=±0.32
    -->
    <link name="table_link">

      <!-- Столешница -->
      <visual name="top_visual">
        <pose>0 0 0.755 0 0 0</pose>
        <geometry><box><size>1.10 0.74 0.05</size></box></geometry>
        <material>
          <ambient>0.65 0.45 0.25 1</ambient>
          <diffuse>0.72 0.52 0.30 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <collision name="top_col">
        <pose>0 0 0.755 0 0 0</pose>
        <geometry><box><size>1.10 0.74 0.05</size></box></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
        </surface>
      </collision>

      <!-- Ножка -X -Y -->
      <visual name="leg_fl_vis"><pose>-0.50 -0.32 0.365 0 0 0</pose>
        <geometry><box><size>0.05 0.05 0.73</size></box></geometry>
        <material><ambient>0.42 0.28 0.10 1</ambient><diffuse>0.50 0.34 0.14 1</diffuse></material>
      </visual>
      <collision name="leg_fl_col"><pose>-0.50 -0.32 0.365 0 0 0</pose>
        <geometry><box><size>0.05 0.05 0.73</size></box></geometry></collision>

      <!-- Ножка +X -Y -->
      <visual name="leg_fr_vis"><pose> 0.50 -0.32 0.365 0 0 0</pose>
        <geometry><box><size>0.05 0.05 0.73</size></box></geometry>
        <material><ambient>0.42 0.28 0.10 1</ambient><diffuse>0.50 0.34 0.14 1</diffuse></material>
      </visual>
      <collision name="leg_fr_col"><pose> 0.50 -0.32 0.365 0 0 0</pose>
        <geometry><box><size>0.05 0.05 0.73</size></box></geometry></collision>

      <!-- Ножка -X +Y -->
      <visual name="leg_bl_vis"><pose>-0.50  0.32 0.365 0 0 0</pose>
        <geometry><box><size>0.05 0.05 0.73</size></box></geometry>
        <material><ambient>0.42 0.28 0.10 1</ambient><diffuse>0.50 0.34 0.14 1</diffuse></material>
      </visual>
      <collision name="leg_bl_col"><pose>-0.50  0.32 0.365 0 0 0</pose>
        <geometry><box><size>0.05 0.05 0.73</size></box></geometry></collision>

      <!-- Ножка +X +Y -->
      <visual name="leg_br_vis"><pose> 0.50  0.32 0.365 0 0 0</pose>
        <geometry><box><size>0.05 0.05 0.73</size></box></geometry>
        <material><ambient>0.42 0.28 0.10 1</ambient><diffuse>0.50 0.34 0.14 1</diffuse></material>
      </visual>
      <collision name="leg_br_col"><pose> 0.50  0.32 0.365 0 0 0</pose>
        <geometry><box><size>0.05 0.05 0.73</size></box></geometry></collision>

    </link>
  </model>
</sdf>
