<?xml version="1.0"?>
<sdf version="1.9">
  <model name="small_tray">
    <static>true</static>
    <!--
      Компактный лоток назначения 0.20 × 0.20 м (внутри 0.18×0.18).
      При model pose (X, Y, 0):
        Поверхность дна изнутри: z = 0.720
        Верх стенок:             z = 0.780
    -->
    <link name="tray_link">

      <!-- Стойка под центром лотка -->
      <visual name="pole_vis">
        <pose>0 0 0.345 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.69</size></box></geometry>
        <material>
          <ambient>0.22 0.22 0.26 1</ambient>
          <diffuse>0.30 0.30 0.35 1</diffuse>
          <specular>0.55 0.55 0.55 1</specular>
        </material>
      </visual>
      <collision name="pole_col">
        <pose>0 0 0.345 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.69</size></box></geometry>
      </collision>

      <!-- Дно -->
      <visual name="bottom_vis">
        <pose>0 0 0.710 0 0 0</pose>
        <geometry><box><size>0.30 0.30 0.02</size></box></geometry>
        <material>
          <ambient>0.70 0.55 0.00 1</ambient>
          <diffuse>0.85 0.68 0.05 1</diffuse>
          <specular>0.15 0.12 0.08 1</specular>
        </material>
      </visual>
      <collision name="bottom_col">
        <pose>0 0 0.710 0 0 0</pose>
        <geometry><box><size>0.30 0.30 0.02</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>

      <!-- Стенки -->
      <visual name="wall_left_vis">
        <pose>-0.140 0 0.745 0 0 0</pose>
        <geometry><box><size>0.02 0.30 0.05</size></box></geometry>
        <material><ambient>0.70 0.55 0.00 1</ambient><diffuse>0.85 0.68 0.05 1</diffuse></material>
      </visual>
      <collision name="wall_left_col">
        <pose>-0.140 0 0.745 0 0 0</pose>
        <geometry><box><size>0.02 0.30 0.05</size></box></geometry>
      </collision>

      <visual name="wall_right_vis">
        <pose>0.140 0 0.745 0 0 0</pose>
        <geometry><box><size>0.02 0.30 0.05</size></box></geometry>
        <material><ambient>0.70 0.55 0.00 1</ambient><diffuse>0.85 0.68 0.05 1</diffuse></material>
      </visual>
      <collision name="wall_right_col">
        <pose>0.140 0 0.745 0 0 0</pose>
        <geometry><box><size>0.02 0.30 0.05</size></box></geometry>
      </collision>

      <visual name="wall_front_vis">
        <pose>0 -0.140 0.745 0 0 0</pose>
        <geometry><box><size>0.30 0.02 0.05</size></box></geometry>
        <material><ambient>0.70 0.55 0.00 1</ambient><diffuse>0.85 0.68 0.05 1</diffuse></material>
      </visual>
      <collision name="wall_front_col">
        <pose>0 -0.140 0.745 0 0 0</pose>
        <geometry><box><size>0.30 0.02 0.05</size></box></geometry>
      </collision>

      <visual name="wall_back_vis">
        <pose>0 0.140 0.745 0 0 0</pose>
        <geometry><box><size>0.30 0.02 0.05</size></box></geometry>
        <material><ambient>0.70 0.55 0.00 1</ambient><diffuse>0.85 0.68 0.05 1</diffuse></material>
      </visual>
      <collision name="wall_back_col">
        <pose>0 0.140 0.745 0 0 0</pose>
        <geometry><box><size>0.30 0.02 0.05</size></box></geometry>
      </collision>

    </link>
  </model>
</sdf>
